# Rasa devcontainer environment template.
#
# IMPORTANT: goes in .devcontainer/, not the repo root -- docker-compose's
# `env_file: - .env` resolves relative to the compose file's own location.
# Copy to .devcontainer/.env (never commit the real one). Rasa has no
# Python-level dotenv loading, so this is the only way these vars load.

# --- Tracker store / lock store / thread-index Redis ---------------------
# Provisioned by the devcontainer's own "redis" service. LOCK_STORE_URL/_DB,
# TRACKER_STORE_URL/_PORT/_DB, and RASA_TRACKER_STORE_BACKEND are all set
# directly in docker-compose.yml, not here.

# Required by docker-compose.yml's redis service.
REDIS_PASSWORD=

# --- LLM (src/components/llm_intent_fallback.py) --------------------------
# Optional -- disables itself if LLM_PROVIDER/LLM_MODEL are unset.

# LLM_PROVIDER=openai
# LLM_MODEL=gpt-4o-mini
# Required for openai-compatible/vllm/sglang; has a default for openai/ollama.
# LLM_BASE_URL=
# Falls back to OPENAI_API_KEY if unset. Not needed for ollama.
# LLM_API_KEY=

# --- Auth ------------------------------------------------------------------

# Same value Action/CVaLab use when calling Rasa's custom routes.
RASA_AUTH_TOKEN=
RASA_REQUIRE_AUTH_TOKEN=true

# No bundled "action" service here -- point at wherever you run Action.
# Already set by docker-compose.yml.
# ACTION_ENDPOINT_URL=http://host.docker.internal:5055/webhook
# Same value Action expects on its /webhook endpoint -- Rasa sends it as
# ?token= on every action-invocation call (see src/core/endpoints.*.yml's
# action_endpoint.token). Distinct value from RASA_AUTH_TOKEN above.
ACTION_AUTH_TOKEN=

# Real per-user identity verification (Phase 2 of the cross-service auth
# redesign) -- off by default. When enabled, Rasa verifies the Bearer token
# Webapp forwards via Keycloak introspection and rejects any request whose
# verified subject doesn't match the user_sub/sender_id it's acting on.
# Reuses Webapp's own Keycloak client credentials -- same values as
# Webapp's KEYCLOAK_ISSUER/KEYCLOAK_CLIENT_ID/KEYCLOAK_CLIENT_SECRET.
# REQUIRE_USER_TOKEN_VERIFICATION=false
# KEYCLOAK_ISSUER=
# KEYCLOAK_CLIENT_ID=
# KEYCLOAK_CLIENT_SECRET=

# --- Misc --------------------------------------------------------------

# Bare http(s)://host[:port] only -- only needed for direct browser calls.
# RASA_CORS=

# Override the RASA_TRACKER_STORE_BACKEND-based endpoints.yml lookup.
# RASA_ENDPOINTS_FILE=

# Version/build metadata for GET /version -- cosmetic, safe to leave unset.
# RASA_VERSION=
# RASA_COMMIT_SHA=
# RASA_IMAGE_TAG=
# RASA_BUILD_DATE=
# RASA_SSOT_VERSION=
